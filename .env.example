# LLM（OpenAI 兼容；也可用 xAI / 其他 base）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding（可与 LLM 同 key；不填则用本地 TF 向量）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# 公网地址（专属页 / x402 resource）
JOB_BLOCK_PUBLIC_URL=https://qiu-zhi-agent.onrender.com

# OKX.AI / x402 收款（生产 · HTTP 卖家 SDK）
PAY_TO_ADDRESS=
JOB_BLOCK_PAY_TO=
JOB_BLOCK_NETWORK=eip155:196
JOB_BLOCK_PRICE_USD=19.99
JOB_BLOCK_PRICE_USDC=19.99
# X Layer USDT
JOB_BLOCK_USDC_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
# OKX 开发者平台 Facilitator
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 生产强制付费：1
JOB_BLOCK_REQUIRE_PAYMENT=1
# 开发：允许 POST /api/access/unlock { dev:true }；生产务必 0
JOB_BLOCK_DEV_AUTH=0

# X (Twitter) API —— 可选
TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN=

# Telegram Alert（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据目录（默认 ./data）
JOB_BLOCK_DATA_DIR=
