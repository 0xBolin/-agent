# LLM（OpenAI 兼容；也可用 xAI / 其他 base）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding（可与 LLM 同 key；不填则用本地 TF 向量）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# 公网地址（专属页 / OKX.AI 回调）
JOB_BLOCK_PUBLIC_URL=http://127.0.0.1:8787

# OKX.AI / x402 收款（生产）
JOB_BLOCK_PAY_TO=
JOB_BLOCK_NETWORK=eip155:196
JOB_BLOCK_PRICE_USDC=5
JOB_BLOCK_USDC_ADDRESS=
# 生产强制付费：1
JOB_BLOCK_REQUIRE_PAYMENT=
# 开发：允许 POST /api/access/unlock { dev:true } 生成测试专属链接（不代登）
# 生产务必 JOB_BLOCK_DEV_AUTH=0 或 NODE_ENV=production
JOB_BLOCK_DEV_AUTH=1

# X (Twitter) API —— 可选
TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN=

# Telegram Alert（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据目录（默认 ./data）
JOB_BLOCK_DATA_DIR=
